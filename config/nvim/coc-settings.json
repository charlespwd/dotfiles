{
  "diagnostic.displayByAle": true,
  "javascript.preferences.importModuleSpecifier": "non-relative",
  "javascript.validate.enable": false,
  "coc.preferences.formatOnType": true,
  "tsserver.enable": true,
  "tsserver.log": "verbose",
  "tsserver.trace.server": "verbose",
  "tsserver.implicitProjectConfig.checkJs": true,
  "snippets.extends": {
    "typescriptreact": ["typescript"]
  },
  "coverage.enabled": true,
  "coverage.uncoveredSign.text": "⦿",
  "coverage.uncoveredSign.hlGroup": "UncoveredLine",
  "coverage.jsonReportPath": "coverage/coverage-final.json",
  "languageserver": {
    // "liquid-dev": {
    //   "command": "liquid-language-server",
    //   "trace.server": "verbose",
    //   "filetypes": ["liquid", "liquid"],
    //   "rootPatterns": [".theme-check.yml", "snippets/*"]
    // },
    "liquid": {
      "command": "shopify",
      "args": ["theme", "language-server"],
      "trace.server": "verbose",
      "filetypes": ["liquid", "liquid"],
      "rootPatterns": [".theme-check.yml", "snippets/*"]
    },
  },
  "coc.source.emoji.filetypes": [
    "markdown",
    "vimwiki"
  ],
  "snippets.ultisnips.pythonPrompt": false
}
